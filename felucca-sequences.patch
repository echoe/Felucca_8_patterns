diff --git a/firmware/src/patbank.c b/firmware/src/patbank.c
new file mode 100644
index 0000000..acabdd3
--- /dev/null
+++ b/firmware/src/patbank.c
@@ -0,0 +1,209 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 Leo Kuroshita (@kurogedelic), Hügelton Instruments */
+/* Sequences: eight per track (FELUCCA_PATBANK). A track plays one of them at a time: trk[].step is the one playing, the
+ * other seven live in a RAM mirror (pb_pat, packed as a project packs steps: 9 bytes). Each sequence has its own steps, its
+ * own LEN (P_SLEN) and its own automation (the track's motion records, at most PB_MO_MAX = 64 of them while it is not the
+ * one playing). DIV, SWING, GATE, QUANTIZE and the sound stay the track's.
+ * Switching (pb_select): the playing sequence is packed into the mirror, the chosen one is put into the track, at once,
+ * in the middle of a pass (the playhead keeps its step). Main loop only.
+ * Persistence (patbank_store.c): the project record keeps the sequence that plays; the others are in flash, five stores
+ * (project A..D, the live music) of six objects: object o < 5 holds sequences 6 o .. 6 o + 5 (q = track * 8 + slot), object
+ * 5 the last two and the rest (the sequence each track plays, the LENs, the automation of the sequences not playing). */
+#if FELUCCA_PATBANK
+#define PB_N 8u                          /* sequences per track */
+#define PB_NSEQ (NTRK * PB_N)
+#define PB_STEP_B 9u                     /* a step packed: project.c proj_pack's nine bytes */
+#define PB_PAT_B (NSTEP * PB_STEP_B)
+#define PB_MO_MAX 64u                    /* automation records of a sequence that is not playing */
+#define PB_PER 6u                        /* sequences an object holds */
+#define PB_NOBJ 6u
+#define PB_NSTORE 5u
+#define PB_LIVE 4u                       /* the live music's store */
+#define PB_HDR 8u
+#define PB_KEY0 19u                      /* SEQ held: C5 .. G5, the eight rightmost keys, are sequences 1..8 */
+#define PB_META_O 5u
+#define PB_OBJ_MAX ST_PAYLOAD_MAX
+typedef struct { uint8_t count, on; motion_event_t ev[PB_MO_MAX]; } pb_mo_t;
+
+static uint8_t pb_cur[NTRK];             /* the sequence each track plays, 0..7 */
+static uint8_t pb_len[PB_NSEQ];          /* LEN of each (the playing one's is the track's P_SLEN) */
+static uint8_t pb_pat[PB_NSEQ][PB_PAT_B] __attribute__((section(".pool")));
+static pb_mo_t pb_mo[PB_NSEQ] __attribute__((section(".pool")));   /* (the playing sequence's: motion) */
+static uint8_t pb_ready;
+static uint8_t pb_dirty;                 /* bit o: the live store's object o is older than the mirror */
+static uint32_t pb_gen;                  /* + 1 per change (autosave_sig) */
+
+/* ---- steps <-> bytes: the bytes of project.c proj_pack / proj_unpack ---- */
+static void pb_pack_step(uint8_t *b, const step_t *s)
+{
+    uint32_t r = step_ratchet(s) - 1u, nd = (uint32_t)step_nudge(s) & 15u, j;
+    uint32_t n = s->n > 4u ? 4u : s->n, tm = s->time > ST_REST ? ST_REST : s->time;
+    for (j = 0; j < 4u; j++)
+        b[j] = (uint8_t)((s->note[j] > 127u ? 127u : s->note[j]) | (nd >> j & 1u) << 7);
+    b[4] = (uint8_t)(n | tm << 3 | (s->flags & 3u) << 5);
+    b[5] = (uint8_t)((s->vel > 127u ? 127u : s->vel) | (r & 1u) << 7);
+    b[6] = s->hit;
+    b[7] = s->acc & s->hit;
+    b[8] = (uint8_t)((s->probability > 101u ? 101u : s->probability) | (r >> 1) << 7);
+}
+static int pb_unpack_step(step_t *s, const uint8_t *b)
+{
+    uint32_t meta = b[4], nd = 0, j;
+    for (j = 0; j < 4u; j++) {
+        nd |= (uint32_t)(b[j] >> 7) << j;
+        s->note[j] = b[j] & 127u;
+    }
+    s->n = meta & 7u;
+    s->time = (meta >> 3) & 3u;
+    s->flags = (meta >> 5) & 3u;
+    s->vel = b[5] & 127u;
+    meta |= (uint32_t)(b[5] & 128u) << 1;
+    s->hit = b[6];
+    s->acc = b[7];
+    s->probability = b[8] & 127u;
+    meta |= (uint32_t)(b[8] & 128u) << 2;
+    if ((meta & 255u) > 127u || s->n > 4u || s->time > ST_REST || s->probability > 101u || (s->acc & ~s->hit))
+        return 0;
+    step_set_ratchet(s, (meta >> 8) + 1u);
+    step_set_nudge(s, (int32_t)(nd ^ 8u) - 8);
+    return 1;
+}
+static void pb_pack_pat(uint8_t *d, const step_t *st)
+{
+    uint32_t i;
+    for (i = 0; i < NSTEP; i++)
+        pb_pack_step(d + i * PB_STEP_B, &st[i]);
+}
+static int pb_unpack_pat(step_t *st, const uint8_t *d)   /* 0: a step is no step: every one empty */
+{
+    uint32_t i;
+    for (i = 0; i < NSTEP; i++)
+        if (!pb_unpack_step(&st[i], d + i * PB_STEP_B)) {
+            for (i = 0; i < NSTEP; i++)
+                step_clear(&st[i]);
+            return 0;
+        }
+    return 1;
+}
+
+static void pb_clear_all(void)
+{
+    uint32_t q;
+    step_t e[NSTEP];
+    for (q = 0; q < NSTEP; q++)
+        step_clear(&e[q]);
+    pb_pack_pat(pb_pat[0], e);
+    for (q = 1; q < PB_NSEQ; q++)
+        memcpy(pb_pat[q], pb_pat[0], PB_PAT_B);
+    memset(pb_mo, 0, sizeof pb_mo);
+    memset(pb_cur, 0, sizeof pb_cur);
+    for (q = 0; q < PB_NSEQ; q++)
+        pb_len[q] = (uint8_t)TP[P_SLEN].def;
+    pb_ready = 1;
+}
+static void pb_need(void) { if (!pb_ready) pb_clear_all(); }
+
+/* the playing sequence of track t into the mirror (its steps, its LEN); marks the live store's objects that changed */
+static void pb_sync(uint32_t t)
+{
+    uint8_t b[PB_PAT_B];
+    uint32_t q;
+    pb_need();
+    q = t * PB_N + pb_cur[t];
+    pb_pack_pat(b, trk[t].step);
+    if (memcmp(pb_pat[q], b, PB_PAT_B)) {
+        memcpy(pb_pat[q], b, PB_PAT_B);
+        pb_dirty |= (uint8_t)(1u << (q / PB_PER));
+        pb_gen++;
+    }
+    if (pb_len[q] != (uint8_t)trk[t].p[P_SLEN]) {
+        pb_len[q] = (uint8_t)trk[t].p[P_SLEN];
+        pb_dirty |= 1u << PB_META_O;
+        pb_gen++;
+    }
+}
+static void pb_sync_all(void)
+{
+    uint32_t t;
+    for (t = 0; t < NTRK; t++)
+        pb_sync(t);
+}
+
+/* a sequence with a note or a hit in it (the playing one: the track's steps) */
+static int pb_filled(uint32_t t, uint32_t slot)
+{
+    uint32_t i;
+    pb_need();
+    if (slot == pb_cur[t])
+        return !seq_is_empty(&trk[t]);
+    for (i = 0; i < NSTEP; i++) {
+        const uint8_t *b = pb_pat[t * PB_N + slot] + i * PB_STEP_B;
+        if ((b[4] & 7u) || b[6])
+            return 1;
+    }
+    return 0;
+}
+
+/* track t plays sequence `slot`. 0 done; 1 no such; 2 the playing sequence has more than PB_MO_MAX automation records
+ * (it could not be kept); 3 the automation of the sequence does not fit with the other tracks' */
+static int pb_select(uint32_t t, uint32_t slot)
+{
+    track_t *tr;
+    motion_store_t mo, in;
+    step_t ns[NSTEP];
+    uint32_t q, old, i, f;
+    if (t >= NTRK || slot >= PB_N)
+        return 1;
+    pb_need();
+    if (slot == pb_cur[t])
+        return 0;
+    tr = &trk[t];
+    motion_snapshot_track(tr, &mo);
+    if (mo.count > PB_MO_MAX)
+        return 2;
+    q = t * PB_N + slot;
+    old = t * PB_N + pb_cur[t];
+    memset(&in, 0, sizeof in);
+    in.count = pb_mo[q].count;
+    in.on = pb_mo[q].on ? (uint8_t)(1u << t) : 0u;
+    for (i = 0; i < in.count && i < PB_MO_MAX; i++)
+        in.event[i] = pb_mo[q].ev[i];
+    if (in.count > PB_MO_MAX || !motion_valid(&in))
+        memset(&in, 0, sizeof in);
+    for (i = 0; i < in.count; i++)
+        if ((in.event[i].place >> 6) != t)
+            memset(&in, 0, sizeof in);
+    pb_sync(t);
+    (void)pb_unpack_pat(ns, pb_pat[q]);
+    if (motion_replace_track(tr, &in))
+        return 3;
+    pb_mo[old].count = mo.count;
+    pb_mo[old].on = (uint8_t)(mo.on != 0u);
+    for (i = 0; i < mo.count; i++)
+        pb_mo[old].ev[i] = mo.event[i];
+    pb_mo[q].count = 0;
+    f = motion_guard();
+    memcpy(tr->step, ns, sizeof ns);
+    tr->p[P_SLEN] = (int16_t)clamp((int32_t)pb_len[q], TP[P_SLEN].min, TP[P_SLEN].max);
+    tr->rh_n = tr->rskip_n = 0;
+    motion_unguard(f);
+    pb_cur[t] = (uint8_t)slot;
+    pb_dirty |= (uint8_t)(1u << (q / PB_PER) | 1u << (old / PB_PER) | 1u << PB_META_O);
+    pb_gen++;
+    return 0;
+}
+
+/* the music was loaded (project.c project_restore_runtime): every track plays sequence 1 of an empty bank, the loaded
+ * steps and LEN in it. A store (patbank_store.c) fills the rest */
+static void pb_reset_to_live(void)
+{
+    uint32_t t;
+    pb_clear_all();
+    for (t = 0; t < NTRK; t++)
+        pb_sync(t);
+    pb_dirty = 0x3Fu;
+    pb_gen++;
+}
+#else
+#define pb_gen 0u
+#endif
diff --git a/firmware/src/patbank_store.c b/firmware/src/patbank_store.c
new file mode 100644
index 0000000..1c2a0b6
--- /dev/null
+++ b/firmware/src/patbank_store.c
@@ -0,0 +1,140 @@
+/* SPDX-License-Identifier: GPL-3.0-only
+ * Copyright (C) 2026 Leo Kuroshita (@kurogedelic), Hügelton Instruments */
+/* The sequence banks in flash (patbank.c): store s (0..3 the projects A..D, PB_LIVE the music as it is now), six objects
+ * OBJ_PB0 + 6 s + o, each an A/B pair of storage.c. Payload: 8 bytes {'P', 'B', 1, o, 0 x 4}, then
+ *   o < 5   six sequences (576 bytes each), 3464 bytes
+ *   o = 5   the last two sequences, the sequence each track plays (4), the 32 LENs, per sequence its automation record
+ *           count and ON (2 bytes), then the records of the sequences with some (3 bytes each, in order); the playing
+ *           sequence's are in the project record, not here. At most PB_META_RECS of them: more is refused (pb_meta_ok) */
+#if FELUCCA_PATBANK && FELUCCA_FLASH
+#define PB_META_FIX (PB_HDR + 2u * PB_PAT_B + NTRK + PB_NSEQ + 2u * PB_NSEQ)
+#define PB_META_RECS ((PB_OBJ_MAX - PB_META_FIX) / 3u)
+static uint8_t pb_wire[PB_OBJ_MAX] __attribute__((aligned(4), section(".pool")));
+
+static uint32_t pb_obj_pats(uint32_t o) { return o < PB_META_O ? PB_PER : PB_NSEQ - PB_PER * PB_META_O; }
+static uint32_t pb_records(void)            /* automation records the mirror holds outside the playing sequences */
+{
+    uint32_t t, n = 0;
+    for (t = 0; t < PB_NSEQ; t++)
+        if (t % PB_N != pb_cur[t / PB_N])
+            n += pb_mo[t].count;
+    return n;
+}
+static int pb_meta_ok(void) { return pb_records() <= PB_META_RECS; }
+
+/* object o -> pb_wire; its length */
+static uint32_t pb_build(uint32_t o)
+{
+    uint32_t n = pb_obj_pats(o), pos = PB_HDR, q;
+    memset(pb_wire, 0, PB_HDR);
+    pb_wire[0] = 'P'; pb_wire[1] = 'B'; pb_wire[2] = 1; pb_wire[3] = (uint8_t)o;
+    memcpy(pb_wire + pos, pb_pat[o * PB_PER], n * PB_PAT_B);
+    pos += n * PB_PAT_B;
+    if (o == PB_META_O) {
+        memcpy(pb_wire + pos, pb_cur, NTRK); pos += NTRK;
+        memcpy(pb_wire + pos, pb_len, PB_NSEQ); pos += PB_NSEQ;
+        for (q = 0; q < PB_NSEQ; q++) {
+            int on = q % PB_N != pb_cur[q / PB_N];
+            pb_wire[pos++] = on ? pb_mo[q].count : 0;
+            pb_wire[pos++] = on ? pb_mo[q].on : 0;
+        }
+        for (q = 0; q < PB_NSEQ; q++)
+            if (q % PB_N != pb_cur[q / PB_N]) {
+                memcpy(pb_wire + pos, pb_mo[q].ev, pb_mo[q].count * sizeof(motion_event_t));
+                pos += pb_mo[q].count * (uint32_t)sizeof(motion_event_t);
+            }
+    }
+    return pos;
+}
+
+/* the objects of `mask` of store s -> flash; 0 ok. Syncs the playing sequences first */
+static int pb_store_save(uint32_t s, uint32_t mask)
+{
+    uint32_t o;
+    pb_need();
+    pb_sync_all();
+    if (!pb_meta_ok())
+        return 3;
+    for (o = 0; o < PB_NOBJ; o++)
+        if ((mask >> o) & 1u) {
+            uint32_t n = pb_build(o);
+            if (st_save(OBJ_PB0 + s * PB_NOBJ + o, pb_wire, n))
+                return 2;
+        }
+    return 0;
+}
+
+/* store s -> the mirror, after the music (steps, LEN, automation: the playing sequences) was loaded; 0: no such store
+ * (the mirror holds just the loaded music, pb_reset_to_live) */
+static int pb_store_load(uint32_t s)
+{
+    uint32_t o, q, t, pos, n;
+    uint8_t cur[NTRK], len[PB_NSEQ], cnt[PB_NSEQ], on[PB_NSEQ];
+    pb_reset_to_live();
+    n = (uint32_t)st_load(OBJ_PB0 + s * PB_NOBJ + PB_META_O, pb_wire, sizeof pb_wire);
+    if ((int)n < 0 || n < PB_META_FIX || pb_wire[0] != 'P' || pb_wire[1] != 'B' || pb_wire[2] != 1 || pb_wire[3] != PB_META_O)
+        return 0;
+    pos = PB_HDR + 2u * PB_PAT_B;
+    memcpy(cur, pb_wire + pos, NTRK); pos += NTRK;
+    memcpy(len, pb_wire + pos, PB_NSEQ); pos += PB_NSEQ;
+    for (q = 0; q < PB_NSEQ; q++) {
+        cnt[q] = pb_wire[pos++];
+        on[q] = pb_wire[pos++];
+    }
+    for (t = 0; t < NTRK; t++)
+        if (cur[t] >= PB_N)
+            return 0;
+    {   /* the records, checked against the length before any of it is kept */
+        uint32_t tot = 0;
+        for (q = 0; q < PB_NSEQ; q++) {
+            if (cnt[q] > PB_MO_MAX) return 0;
+            tot += cnt[q];
+        }
+        if (pos + tot * sizeof(motion_event_t) > n) return 0;
+    }
+    memcpy(pb_pat[PB_META_O * PB_PER], pb_wire + PB_HDR, 2u * PB_PAT_B);
+    for (q = 0; q < PB_NSEQ; q++) {
+        uint32_t k;
+        pb_mo[q].count = 0;
+        if (!cnt[q])
+            continue;
+        pb_mo[q].on = on[q] != 0u;
+        for (k = 0; k < cnt[q]; k++, pos += sizeof(motion_event_t))
+            memcpy(&pb_mo[q].ev[k], pb_wire + pos, sizeof(motion_event_t));
+        pb_mo[q].count = cnt[q];
+    }
+    for (q = 0; q < PB_NSEQ; q++)
+        pb_len[q] = len[q] >= (uint32_t)TP[P_SLEN].min && len[q] <= (uint32_t)TP[P_SLEN].max ? len[q] : (uint8_t)TP[P_SLEN].def;
+    for (o = 0; o < PB_META_O; o++) {
+        n = (uint32_t)st_load(OBJ_PB0 + s * PB_NOBJ + o, pb_wire, sizeof pb_wire);
+        if ((int)n == (int)(PB_HDR + PB_PER * PB_PAT_B) && pb_wire[0] == 'P' && pb_wire[1] == 'B' && pb_wire[2] == 1 &&
+            pb_wire[3] == o)
+            memcpy(pb_pat[o * PB_PER], pb_wire + PB_HDR, PB_PER * PB_PAT_B);
+    }
+    for (t = 0; t < NTRK; t++) {            /* the sequence a track plays is the loaded music's (the record) */
+        pb_cur[t] = cur[t];
+        pb_mo[t * PB_N + cur[t]].count = 0;
+        pb_sync(t);
+    }
+    pb_dirty = 0x3Fu;
+    pb_gen++;
+    return 1;
+}
+
+/* the autosave's companion (project.c autosave_poll): the live store, the objects that changed; 0 ok */
+static int pb_flush_live(void)
+{
+    uint32_t o, m;
+    pb_sync_all();
+    m = pb_dirty;
+    if (!m)
+        return 0;
+    for (o = 0; o < PB_NOBJ; o++)
+        if ((m >> o) & 1u) {
+            if (pb_store_save(PB_LIVE, 1u << o))
+                return 1;
+            pb_dirty &= (uint8_t)~(1u << o);
+        }
+    return 0;
+}
+#endif
